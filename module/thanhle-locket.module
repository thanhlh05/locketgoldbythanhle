#!name=Locket Gold  by Thanh Lê
#!desc=Gold + 60s video + mic + upload video + friends + Moments/Streak/Chat + Widget + Caption
#!author=Thanh Lê
#!homepage=https://github.com/thanhlh05/locket-gold-balance

[Script]
# RevenueCat
revenuecat = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+/?$)|^https:\/\/api-production\.8-lives-cat\.io\/.+\/(receipts$|subscribers\/[^/]+/?$), script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold-balance/main/scripts/locket.js, requires-body=true, max-size=-1, timeout=60

# Xóa ETag
deleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers)|^https:\/\/api-production\.8-lives-cat\.io\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold-balance/main/scripts/delheader.js, timeout=30

# Force US
forceUS = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold-balance/main/scripts/forceUS.js, timeout=15

# Remote Config (chỉ lấy phần cần)
forceGold = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold-balance/main/scripts/forceGold.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api-production.8-lives-cat.io, firebaseremoteconfig.googleapis.com